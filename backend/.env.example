# Copie este arquivo para ".env" e preencha os valores reais antes de rodar o backend.
# NUNCA commite o arquivo ".env" — ele contém segredos e já está no .gitignore.

# -----------------------------------------------------------------------------
# Ambiente de execução
# -----------------------------------------------------------------------------
# "development" ou "production". Em produção, os cookies do refresh token são
# sempre enviados com o atributo Secure (exige HTTPS), independentemente do
# valor de COOKIE_SECURE mais abaixo.
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Banco de dados MySQL — OBRIGATÓRIOS: sem eles o backend falha ao iniciar
# -----------------------------------------------------------------------------
# Endereço do servidor MySQL
DB_HOST=<preencha>
# Usuário do MySQL
DB_USER=<preencha>
# Senha do MySQL — trate como segredo, nunca reutilize a de outros ambientes
DB_PASSWORD=<preencha>
# Nome do banco de dados
DB_NAME=<preencha>
# Charset da conexão (normalmente não precisa alterar)
DB_CHARSET=utf8mb4
# Tamanho inicial do pool de conexões MySQL (DBUtils)
DB_POOL_SIZE=5
# Número máximo de conexões simultâneas permitidas no pool
DB_POOL_MAX_CONNECTIONS=20

# -----------------------------------------------------------------------------
# JWT — OBRIGATÓRIO, mínimo de 32 caracteres (validado na inicialização)
# -----------------------------------------------------------------------------
# Gere uma chave segura com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<preencha>
# Algoritmo de assinatura do token
JWT_ALGORITHM=HS256
# Validade do access token, em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Validade do refresh token, em dias
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Cookies do refresh token
# -----------------------------------------------------------------------------
# Em produção (ENVIRONMENT=production) o backend força Secure=True mesmo que
# esta variável esteja False; use True aqui se servir HTTPS também fora desse fluxo
COOKIE_SECURE=False
# Política SameSite do cookie: "lax", "strict" ou "none"
COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Limite de tentativas de login por IP (sintaxe do slowapi, ex.: "5/minute")
LOGIN_RATE_LIMIT=5/minute

# -----------------------------------------------------------------------------
# Paginação padrão das listagens da API
# -----------------------------------------------------------------------------
# Itens por página quando o cliente não especifica
DEFAULT_PAGE_SIZE=50
# Máximo de itens por página que a API aceita, mesmo se o cliente pedir mais
MAX_PAGE_SIZE=500

# -----------------------------------------------------------------------------
# Storage dos documentos gerados (termos de responsabilidade, notas de remoção)
# -----------------------------------------------------------------------------
# "local" para desenvolvimento, "s3" para produção
STORAGE_BACKEND=local
# Pasta local usada quando STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage

# Necessário apenas quando STORAGE_BACKEND=s3
# Bucket S3 onde os documentos serão salvos
# S3_BUCKET=<preencha>
# Região do bucket S3
# S3_REGION=us-east-1
# Credenciais AWS com permissão de escrita no bucket acima
# AWS_ACCESS_KEY_ID=<preencha>
# AWS_SECRET_ACCESS_KEY=<preencha>

# -----------------------------------------------------------------------------
# Modelos de documentos (.docx)
# -----------------------------------------------------------------------------
# Diretório absoluto opcional com os modelos de termo (.docx). Deixe vazio para
# usar o padrão automático (backend/modelos em dev, /app/modelos no container).
MODELOS_DIR=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Endereços do frontend autorizados a chamar a API, separados por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

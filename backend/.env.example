# Copie este arquivo para ".env" e preencha os valores reais antes de rodar o backend.
# NUNCA commite o arquivo ".env" — ele contém segredos e já está no .gitignore.

# -----------------------------------------------------------------------------
# Ambiente de execução
# -----------------------------------------------------------------------------
# "development" ou "production". Em produção, os cookies do refresh token são
# sempre enviados com o atributo Secure (exige HTTPS), independentemente do
# valor de COOKIE_SECURE mais abaixo.
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Banco de dados MySQL — OBRIGATÓRIOS: sem eles o backend falha ao iniciar
# -----------------------------------------------------------------------------
# Endereço do servidor MySQL
DB_HOST=<preencha>
# Usuário do MySQL
DB_USER=<preencha>
# Senha do MySQL — trate como segredo, nunca reutilize a de outros ambientes
DB_PASSWORD=<preencha>
# Nome do banco de dados
DB_NAME=<preencha>
# Charset da conexão (normalmente não precisa alterar)
DB_CHARSET=utf8mb4
# Tamanho inicial do pool de conexões MySQL (DBUtils)
DB_POOL_SIZE=5
# Número máximo de conexões simultâneas permitidas no pool
DB_POOL_MAX_CONNECTIONS=20

# -----------------------------------------------------------------------------
# JWT — OBRIGATÓRIO, mínimo de 32 caracteres (validado na inicialização)
# -----------------------------------------------------------------------------
# Gere uma chave segura com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<preencha>
# Algoritmo de assinatura do token
JWT_ALGORITHM=HS256
# Validade do access token, em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Validade do refresh token, em dias
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Cookies do refresh token
# -----------------------------------------------------------------------------
# Em produção (ENVIRONMENT=production) o backend força Secure=True mesmo que
# esta variável esteja False; use True aqui se servir HTTPS também fora desse fluxo
COOKIE_SECURE=False
# Política SameSite do cookie: "lax", "strict" ou "none"
COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Limite de tentativas de login por IP (sintaxe do slowapi, ex.: "5/minute")
LOGIN_RATE_LIMIT=5/minute

# -----------------------------------------------------------------------------
# Paginação padrão das listagens da API
# -----------------------------------------------------------------------------
# Itens por página quando o cliente não especifica
DEFAULT_PAGE_SIZE=50
# Máximo de itens por página que a API aceita, mesmo se o cliente pedir mais
MAX_PAGE_SIZE=500

# -----------------------------------------------------------------------------
# Storage dos documentos gerados (termos de responsabilidade, notas de remoção)
# -----------------------------------------------------------------------------
# "local" para desenvolvimento, "s3" para produção
STORAGE_BACKEND=local
# Pasta local usada quando STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage

# Necessário apenas quando STORAGE_BACKEND=s3
# Bucket S3 onde os documentos serão salvos
# S3_BUCKET=<preencha>
# Região do bucket S3
# S3_REGION=us-east-1
# Credenciais AWS com permissão de escrita no bucket acima
# AWS_ACCESS_KEY_ID=<preencha>
# AWS_SECRET_ACCESS_KEY=<preencha>

# -----------------------------------------------------------------------------
# Modelos de documentos (.docx)
# -----------------------------------------------------------------------------
# Diretório absoluto opcional com os modelos de termo (.docx). Deixe vazio para
# usar o padrão automático (backend/modelos em dev, /app/modelos no container).
MODELOS_DIR=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Endereços do frontend autorizados a chamar a API, separados por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# URL pública do frontend
# -----------------------------------------------------------------------------
# Usada para montar os links dos e-mails enviados pelo sistema
APP_PUBLIC_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# E-mail (SMTP)
# -----------------------------------------------------------------------------
# "smtp" envia de verdade; "memory" só guarda em memória (usado nos testes)
MAIL_BACKEND=smtp
# Servidor SMTP
SMTP_HOST=mail.revalle.com.br
# Porta do servidor SMTP (465 = SSL implícito)
SMTP_PORT=465
# Usuário da conta que envia os e-mails
SMTP_USER=naoresponda@revalle.com.br
# Senha da conta SMTP — segredo, defina só no servidor
SMTP_PASS=<defina no servidor>
# Remetente exibido; se vazio, usa SMTP_USER
SMTP_FROM=
# Verifica o certificado TLS do servidor SMTP (recomendado). Só defina false se o
# certificado do servidor de e-mail não corresponder ao nome do host.
SMTP_VERIFY_TLS=true

# -----------------------------------------------------------------------------
# Base de colaboradores (Postgres, somente leitura) e sincronização diária
# -----------------------------------------------------------------------------
# URL de conexão com o usuário de LEITURA do Postgres de colaboradores
COLABORADORES_DATABASE_URL=postgres://<usuario_leitura>:<senha>@agente_revalle_postgres:5432/agente_revalle
# Tabela e schema onde ficam os colaboradores
COLABORADORES_TABLE=colaboradores-revalle
COLABORADORES_SCHEMA=public
# Mapeamento opcional de colunas (deixe vazio para usar o padrão)
COLABORADORES_COLUMNS=
# Horário (HH:MM) da sincronização diária
COLABORADORES_SYNC_HORA=05:00

# -----------------------------------------------------------------------------
# Agendador de tarefas em segundo plano (sincronização, alertas)
# -----------------------------------------------------------------------------
# False desliga o agendador (útil em testes e ao rodar vários workers)
SCHEDULER_ENABLED=True

# -----------------------------------------------------------------------------
# 2FA (TOTP)
# -----------------------------------------------------------------------------
# Chave que cifra o segredo TOTP no banco. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=
# Vazia = 2FA desligado (o Gestor entra só com a senha e os endpoints de 2FA respondem 503). Trocar a chave invalida os autenticadores já cadastrados.

# -----------------------------------------------------------------------------
# Login por e-mail
# -----------------------------------------------------------------------------
# Domínio aceito no login (só e-mails @<domínio>; comparação sem maiúsculas)
LOGIN_EMAIL_DOMINIO=revalle.com.br

# -----------------------------------------------------------------------------
# Assinatura eletrônica (RevSign)
# -----------------------------------------------------------------------------
# True liga a integração: o termo vai ao RevSign em PDF (convertido com o LibreOffice da imagem)
REVSIGN_ENABLED=False
# Base completa da API de contrato do RevSign, sem "/" no fim
# (interna: http://agente_revalle_revsign:3000/api/revalle/patrimonio/v1)
REVSIGN_BASE_URL=
# Chave da API — segredo (= NEXT_PRIVATE_REVALLE_PATRIMONIO_API_KEY no RevSign)
REVSIGN_API_TOKEN=
# Segredo que valida os webhooks recebidos — segredo (= NEXT_PRIVATE_REVALLE_PATRIMONIO_WEBHOOK_SECRET no RevSign)
REVSIGN_WEBHOOK_SECRET=
# URL a cadastrar no webhook do RevSign: http://agente_revalle_stock-sys-backend:8000/api/integrations/revsign/webhook
# (fora da rede interna: <APP_PUBLIC_URL>/api/integrations/revsign/webhook)
# Eventos: todos os termo.* (sent, signed, rejected, expired, cancelled)
# Os modelos de termo (backend/modelos) levam o marcador {{assinatura}}; ao trocar um modelo,
# rode `python scripts/marcar_assinatura.py` (a partir de backend/)

# -----------------------------------------------------------------------------
# Alertas do painel (limiares, em dias)
# -----------------------------------------------------------------------------
# Garantia que vence em até N dias
ALERTA_GARANTIA_DIAS=30
# Termo de responsabilidade sem assinatura há mais de N dias
ALERTA_TERMO_PENDENTE_DIAS=3
# Devolução pendente há mais de N dias
ALERTA_DEVOLUCAO_PENDENTE_DIAS=7
# Equipamento em manutenção há mais de N dias
ALERTA_MANUTENCAO_DIAS=15

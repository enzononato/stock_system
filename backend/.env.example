# Copie este arquivo para .env e preencha os valores

# Banco de dados MySQL
DB_HOST=72.61.53.20
DB_USER=root
DB_PASSWORD=Root123@
DB_NAME=stock_sys_db

# JWT - USE UMA STRING LONGA E ALEATÓRIA EM PRODUÇÃO
JWT_SECRET=1234567890abcdef1234567890abcdef

# Storage: "local" para dev, "s3" para produção
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage

# S3 (necessário apenas se STORAGE_BACKEND=s3)
# S3_BUCKET=revalle-stock-docs
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# CORS - endereços do frontend separados por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

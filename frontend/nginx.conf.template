server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Aumenta o limite para upload de PDFs assinados
    client_max_body_size 50M;

    # 127.0.0.11 é o resolvedor DNS embutido do Docker, disponível em toda rede
    # bridge/overlay — mesmo endereço sob docker-compose, Swarm ou qualquer
    # orquestrador construído sobre o Docker Engine (o que inclui EasyPanel).
    # Necessário porque abaixo o proxy_pass usa uma VARIÁVEL como destino, não
    # uma string estática: com string estática, o nginx resolveria o hostname
    # uma única vez, na inicialização, e travaria com "host not found in
    # upstream" se o container do backend ainda não estivesse registrado na
    # rede nesse instante — ordem de início entre serviços não é garantida.
    # Com variável + resolver, a resolução passa a ser por requisição: o nginx
    # sobe mesmo sem o backend disponível ainda, e resolve o IP a cada chamada.
    resolver 127.0.0.11 valid=30s;

    # Proxy para o backend FastAPI. ${BACKEND_HOST}/${BACKEND_PORT} são
    # resolvidos por envsubst na inicialização do container (mecanismo padrão
    # da imagem oficial nginx:alpine para arquivos em /etc/nginx/templates/,
    # ver frontend/Dockerfile) — não hardcoda o nome do serviço backend, então
    # funciona com qualquer nome que a plataforma de deploy atribuir a ele,
    # sem precisar reconstruir a imagem.
    location /api/ {
        set $backend_upstream ${BACKEND_HOST}:${BACKEND_PORT};
        # Sem trailing slash na URI de destino, de propósito: assim o nginx
        # repassa a URI completa (/api/...) sem reescrever, que é o que os
        # routers do FastAPI esperam (todos com prefix="/api/...").
        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Suporte a cookies HttpOnly (refresh_token)
        proxy_pass_header Set-Cookie;
    }

    # SPA fallback — todas as rotas servem o index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache de assets estáticos
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;
    gzip_min_length 1024;
}

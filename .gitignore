# Ambiente virtual e cache Python
/venv
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Build
/build
/dist

# Variáveis de ambiente — contêm segredos reais (senha do banco, JWT_SECRET
# etc.), nunca devem ser commitadas. Use backend/.env.example como modelo.
.env
.env.local
.env.*.local
backend/.env

# Arquivos gerados em runtime pelo storage local do backend
backend/storage/

# Documentos com dados pessoais (CPF, nomes completos, currículos, boletos).
# As pastas continuam existindo em disco — apenas não são mais versionadas.
# Ver docs/REMOCAO_HISTORICO_GIT.md para o expurgo do que já foi commitado.
/terms
/termos_assinados
/termos_devolucao
/termos_devolucao_assinados
/notas_remocao

# Dependências e build do frontend (reinstalados/gerados a cada build)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/
frontend/.output/
frontend/.wrangler/
.output/
.wrangler/

# Relatório de cobertura do Vitest (gerado por `npm run test:coverage`)
frontend/coverage/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log

# Configuração local do Claude Code (específica da máquina/usuário)
.claude/settings.local.json
.claude/worktrees/
.claude/settings.json

# Termo de origem enviado pelo usuário: contém dados pessoais reais (nome e CPF)
# de um funcionário. O template derivado, sem PII, é backend/modelos/termo.docx.
/Termo.docx

# Backup manual do projeto (não deve ser versionado)
/stock_system.rar
